// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId         String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  phone          String    @unique
  hashedPassword String
  hashedOTP      Json?
  fullname       String?
  isVerified     Boolean?  @default(false)
  isAdmin        Boolean?  @default(false)
  history        Json?     @default("{}")
  quizCount      Int?      @default(0)
  currentScore   Int?      @default(0)
  rank           Int?      @default(1)
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @updatedAt

  // Relations
  submittedQuizzes Quiz[]     @relation("QuizSubmitter")
  approvedQuizzes  Quiz[]     @relation("QuizApprover")
  performedAudits  AuditLog[] @relation("AuditPerformer")
  targetAudits     AuditLog[] @relation("AuditTarget")
  OTP              OTP[]
}

model Quiz {
  quizId    String   @id @default(uuid())
  question  String
  category  String
  options   String[]
  answer    String
  flagged   Boolean  @default(false)
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submitter   User    @relation("QuizSubmitter", fields: [submitterId], references: [userId])
  submitterId String
  approver    User?   @relation("QuizApprover", fields: [approverId], references: [userId])
  approverId  String? @default("pending")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  description String
  performedAt DateTime @default(now())

  // Relations
  performer   User?   @relation("AuditPerformer", fields: [performerId], references: [userId])
  performerId String?
  target      User?   @relation("AuditTarget", fields: [targetId], references: [userId])
  targetId    String?
}

model OTP {
  id        String   @id @default(uuid())
  hashedOTP String
  createdAt DateTime @default(now())
  expiresAt DateTime

  // Relations
  user   User?   @relation(fields: [userId], references: [userId])
  userId String?

  @@map("otp")
}
